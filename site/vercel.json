{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "^camera-smoother\\.jenny\\.media$" }],
      "destination": "https://smooth.jenny.media/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "^camera-smoother\\.jenny\\.media$" }],
      "destination": "https://smooth.jenny.media/:path*",
      "permanent": true
    },
    {
      "source": "/install.sh",
      "destination": "https://github.com/Jenny-Media/camera-smoother/releases/latest/download/install.sh",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/agent.md",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    }
  ]
}
